# ---------------------------------------------------------------------------
# Self-hosted analytics platform — environment template.
# Copy to .env and adjust for your deployment. Defaults mirror these values.
# ---------------------------------------------------------------------------

# Global
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string

# --- Infrastructure ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Auth/tenant service (OLTP, Postgres)
DATABASE_URL=postgresql://analytics:analytics@127.0.0.1:5432/analytics_auth
# Dashboard-config service keeps its own schema in a separate database.
DATABASE_URL_DASHBOARDS=postgresql://analytics:analytics@127.0.0.1:5432/analytics_dashboards

# --- Service ports (REST / gRPC) ---
PORT_AUTH=4001
PORT_AUTH_GRPC=5001
PORT_INGESTION=4002
PORT_STREAM=4003
PORT_QUERY=4004
PORT_QUERY_GRPC=5004
PORT_ALERTING=4005
PORT_DASHBOARDS=4006

# Internal gRPC endpoints
AUTH_GRPC_URL=127.0.0.1:5001
QUERY_GRPC_URL=127.0.0.1:5004

# --- Streams / batching ---
STREAM_EVENTS=analytics:events
STREAM_GROUP=analytics:events:processors
STREAM_DEAD_LETTER=analytics:events:dead-letter
STREAM_MAX_LEN=1000000

BATCH_MAX_EVENTS=5000
BATCH_MAX_BYTES=1000000
BATCH_MAX_WAIT_MS=2000
BATCH_MAX_RETRIES=5
